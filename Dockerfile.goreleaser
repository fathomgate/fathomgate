# Used by GoReleaser, which supplies the prebuilt binary in the build context.
# Pinned to the multi-arch index digest, same as the runtime stage in
# Dockerfile; keep the two in step (Dependabot updates both).
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY fathomgate /usr/local/bin/fathomgate
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/fathomgate"]
CMD ["serve"]
