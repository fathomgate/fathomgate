# shigechika/eos-mcp v1.3.0 from PyPI (the upload of tag v1.3.0, commit
# bffb89377b3fa6b544b45b0cab44d5191cf8981a; profiles/eos-mcp.yaml is read at
# that commit, and the tests check the installed eos_mcp/*.py files against
# it by sha256). It declares `mcp>=1.2,<2` and `pyeapi` (any version); mcp
# and pyeapi are held at the versions the upstream's own uv.lock resolves at
# that commit (mcp 1.28.1, pyeapi 1.0.4), so the run matches the profile's
# source reading. Everything else is the newest that fits.
#
# Regenerate (then bump EOS_MCP_* in tests/integration/conftest.py):
#   uv pip compile --universal --python-version 3.13 --generate-hashes \
#     requirements.in -o requirements.txt
eos-mcp==1.3.0
mcp==1.28.1
pyeapi==1.0.4
